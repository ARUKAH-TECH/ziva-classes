# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase project: Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key used by privileged operations (publishing terminal reports,
# approving parent change requests, PDF generation). NEVER expose this to
# the browser / prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
